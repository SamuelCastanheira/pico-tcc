;; Ponto de entrada de teste da versão Atmos: o mesmo início do main.atm, mas
;; aguardando direto a tela EQ_TELA. Quando a tela termina, o teste termina
;; (FIM <resultado>), para comparar cada minigame isoladamente.
require "ambiente"     ;; atmos.env.pico com o relógio real (ver ambiente.lua)
set pico = require "pico"

pico.set.window [ title="Ilha da Geladeira" ]
pico.set.effect [ grid=false ]
pico.set.dim ['!', w=1280, h=720]
math.randomseed()

set moedas = 0
set cor_pinguim = "amarelo"

val telas = [
    menu          = "screens/telas_menu/menu",
    person        = "screens/telas_menu/personalizar",
    centro        = "screens/centro/centro",
    dojo          = "screens/minigames/dojo/dojo",
    bean_counters = "screens/minigames/bean_counters/bean_counters",
    pega_puffle   = "screens/minigames/pega_puffles/pega_puffles",
]

val nome = os.getenv("EQ_TELA")
val T = require(telas@(nome))
val v = await T()
set EQ_RESULTADO = string.format("%s moedas=%s", tostring(v), tostring(moedas))
