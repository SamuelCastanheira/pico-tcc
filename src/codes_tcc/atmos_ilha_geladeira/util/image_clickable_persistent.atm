val Image_Hover = require "util/image_hover"
val Clickable = require "util/clickable"

func Image_Clickable_Persistent(id, rect, off, on)
{
    set pub = @{
        id = id,
        rect = rect
    }

    spawn Image_Hover(id, rect, off, on)
    pin click = spawn Clickable(id, rect)
    
    loop {
        await :clock
        if (click.pub)
        {
            set pub.click = id
            set click.pub = nil
        }
        else
        {
            set pub.click = false
        }
    }
}

Image_Clickable_Persistent