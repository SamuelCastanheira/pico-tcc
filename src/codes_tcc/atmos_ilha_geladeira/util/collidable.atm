func Collidable(id, rect, other)
{
    loop
    {
        await :clock
        loop _,e in other{
            if (e && e.pub.rect)
            {
                set col = pico.vs.rect_rect(e.pub.rect, rect)
                if col => set collided = e.pub.id
            }
        }
        if collided => set pub = collided
    }
}

Collidable