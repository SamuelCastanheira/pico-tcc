val Image = require "util/image"

func Image_Hover(id, rect, off, on)
{
    set pub = @{
        id = id,
        rect = rect
    }

    par_or {
        every :clock {
            val m  = pico.get.mouse('%')
            val check_on = pico.vs.pos_rect(@{'%', x=m.x, y=m.y}, rect)
            emit (if on && check_on => :on => :off)
        }
    } with {
        loop {
            watching :on {
                await Image(id,rect, off)
            }
            watching :off {
                await Image(id, rect, on)
            }            
        }
    } 
}


Image_Hover
