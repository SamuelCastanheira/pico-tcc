val Image = require "util/image"

task Image_Hover(id, rect, off, on_)
{
    set pub = [
        id = id,
        rect = rect
    ]

    par:any {
        loop on :clock {
            val m  = pico.get.mouse('%')
            val check_on = pico.vs.pos.rect(['%', x=m.x, y=m.y], rect)
            emit (if on_ && check_on => :on => :off)
        }
    } with {
        loop {
            watching :on {
                await Image(id,rect, off)
            }
            watching :off {
                await Image(id, rect, on_)
            }            
        }
    } 
}


Image_Hover
