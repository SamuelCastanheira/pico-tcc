task Collidable(id, rect, other)
{
    var collided = false
    loop on :clock{
        loop _,e in other{
            if (e && e.pub.rect)
            {
                set col = pico.vs.pos.rect(rect, e.pub.rect)
                if col{
                    set collided = e.pub.id
                    print(e.pub.id, rect.x, rect.y)
                }
            }
        }
        if collided => set pub = collided
    }
}

Collidable