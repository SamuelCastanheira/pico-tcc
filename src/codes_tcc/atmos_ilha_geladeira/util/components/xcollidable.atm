task XCollidable (me, others) {
    loop on :clock {
        if (#others >= 1) {
            loop _,e in others {
                if (me.pub.id != e.pub.id)
                {
                    val col = pico.vs.rect.rect(me.pub.hitbox, e.pub.hitbox)
                    if col {
                        emit @(me) :collided [id=e.pub.id]
                    }
                }
            }
        }
    }
}

XCollidable
