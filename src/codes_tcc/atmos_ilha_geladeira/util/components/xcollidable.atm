task XCollidable (tgt, me, others) {
    loop on :clock {
        loop _,oth in others {
            if (me != oth)
            {
                val col = pico.vs.rect.rect(me.pub.hitbox, oth.pub.hitbox)
                if col {
                    emit @(tgt+1) :collided [me=me, oth=oth]
                }
            }
        }
    }
}

XCollidable
