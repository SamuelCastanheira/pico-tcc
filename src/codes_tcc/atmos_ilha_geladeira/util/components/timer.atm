task Timer(me, dur) {
    set pub = []

    await :timer_start
    
    loop {
        watching :timer_reset {
            var inicio = pico.get.now()
            set pub.dur = dur
            set pub.tempo_atual = 0
            set pub.tempo_decorrido = 0
            set pub.tempo_restante = dur
            set pub.progresso = 0

            watching until (pub.tempo_decorrido >= pub.dur)
            {
                toggle on :timer_pause {
                    loop on :clock {
                        set pub.tempo_atual = pico.get.now()
                        set pub.tempo_decorrido = (pub.tempo_atual - inicio)*1ms
                        set pub.tempo_restante = math.max(0,pub.dur - pub.tempo_decorrido)
                        set pub.progresso = math.min(1, pub.tempo_decorrido /pub.dur)
                    }
                }
            }
            emit @(me) :timer_end
            await :timer_reset
        }
    } 
}

Timer