task Text(opts)
{
    set pub = [
        id = opts.id || nil,
        rect = opts.rect,
    ]

    loop on :draw {
        if (opts.color)
        {
            pico.set.pencil[color=opts.color]
        }
        if (opts.font)
        {
            pico.set.pencil[font=opts.font]
        }
        if (opts.style)
        {
            pico.set.pencil[style=opts.style]
        }

        pico.output.draw.text(opts.text, opts.rect)

    }
}

Text
