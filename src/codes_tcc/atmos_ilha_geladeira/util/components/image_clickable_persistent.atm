val Image_Hover = require "util/components/image_hover"
val Clickable = require "util/components/clickable"


task Image_Clickable_Persistent(id, rect, off, on_)
{
    set pub = [
        id = id,
        rect = rect
    ]

    spawn Image_Hover(id, rect, off, on_)
    pin click = spawn Clickable(id, rect)
    
    loop on :clock{
        if (click.pub)
        {
            print(click.pub)
            set pub.click = id
            set click.pub = nil
        }
        else
        {
            set pub.click = false
        }
    }
}

Image_Clickable_Persistent