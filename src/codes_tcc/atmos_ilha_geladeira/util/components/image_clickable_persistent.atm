val Image_Hover = require "util/components/image_hover"
val XClickable = require "util/components/xclickable"


task Image_Clickable_Persistent(id, rect, off, on_)
{
    set pub = [
        id = id,
        rect = rect
    ]

    spawn Image_Hover(id, rect, off, on_)
    pin click = await XClickable(task)
}

Image_Clickable_Persistent