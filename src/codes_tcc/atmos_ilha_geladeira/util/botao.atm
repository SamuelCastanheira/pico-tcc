val Image = require "util/image"

func Botao(id, rect, off, on)
{
    par_or {
        every :clock {
            val m  = pico.get.mouse('%')
            val on = pico.vs.pos.rect(@{'%', x=m.x, y=m.y}, rect)
            emit (if on => :on => :off)
        }
    } with {
        loop {
            watching :on {
                await Image(rect, off)
            }
            watching :off {
                await Image(rect, on)
            }            
        }
    } with {
        loop {
            await :mouse.button.dn
            val m  = pico.get.mouse('%')
            set click = pico.vs.pos.rect(m, rect)
            if click {  
                break()
            }
        }
    }
    id
}

Botao
