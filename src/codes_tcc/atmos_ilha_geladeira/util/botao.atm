val Image_Clickable_Persistent = require "util/image_clickable_persistent"

func Botao(id, rect, off, on)
{
   pin click =  spawn Clickable(id, rect)
   spawn Image_Hover(id,rect,off,on)

    loop
    {
        await :clock
        if (click.pub)
        {
            break()
        }
    }
    
    id
}

Botao
