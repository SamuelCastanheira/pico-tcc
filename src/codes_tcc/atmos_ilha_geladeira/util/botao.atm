val Image = require "util/image"

func Botao(rect, off, on, estado)
{
    set pub = @{
        output = nil
    }
    loop
    {
        watching :click
        {
            spawn {
                every :clock {
                    val m  = pico.get.mouse('%')
                    val on = pico.vs.pos.rect(@{'%', x=m.x, y=m.y}, rect)
                    emit (if on => :on => :off)
                }
            }

            spawn
            {
                every e in :mouse.button.dn 
                {
                     val m  = pico.get.mouse('%')
                    set click = pico.vs.pos.rect(m, rect)
                    if click
                    {  
                        set pub.output = estado
                        emit :click  
                    }
                }
            }

            loop {
                watching :on {
                    await Image(rect, off)
                }
                watching :off {
                    await Image(rect, on)
                }            
            }
        }
        await @.1
    }
}

Botao
