val Image = require "util/image"

func Botao(y, off, on, estado)
{
    val rect = @{ '%', x=0.5, y=y, w=0.55, h=0.2 }
    set pub = @{
        output = nil
    }
    loop
    {
        watching :click
        {
            spawn {
                every :clock {
                    val m  = pico.get.mouse('!')
                    val on = pico.vs.pos_rect(@{'!', x=m.x, y=m.y}, rect)
                    emit (if on => :on => :off)
                }
            }

            spawn
            {
                every e in :mouse.button.dn 
                {
                    var m = @{'!', x=e.x, y=e.y}
                    set click = pico.vs.pos_rect(m, rect)
                    if click
                    {  
                        emit :click
                        
                    }
                }
            }

            loop {
                watching :on {
                    await Image(rect, off)
                }
                watching :off {
                    await Image(rect, on)
                }            
            }
        }
        await @.1
    }
}

Botao