func Image(rect, path)
{
    every :draw {
        pico.output.draw.image(path, rect)
    }
}

func Botao(y, off, on, estado)
{
    val rect = @{ '%', x=0.5, y=y, w=0.55, h=0.2 }

    spawn {
        every :clock {
            val m  = pico.get.mouse('!')
            val on = pico.vs.pos_rect(@{'!', x=m.x, y=m.y}, rect)
            emit (if on => :on => :off)
        }
    }

    spawn
    {
        every e in :mouse.button.dn 
        {
           var m = @{'!', x=e.x, y=e.y}
           val click = pico.vs.pos_rect(m, rect)
           if click
           {
                emit [:global] :estado
                emit [:global] :end
           }
        }
    }

    loop {
        watching :on {
            await Image(rect, off)
        }
        watching :off {
            await Image(rect, on)
        }
    }
}

func Menu () {
    watching :end
    {
        spawn Image(r, img) where
        {
            r = @{ '%', x=0.5, y=0.5 }
            img = "../../../../assets/imgs/background_menu.png"
        }

        spawn Image(r, img) where
        {
            r = @{ '%', x=0.5, y=0.225, w=0.45, h=0.45 }
            img = "../../../../assets/imgs//logo.png"
        }

        spawn Botao(0.5, off, on, "centro") where
        {
            off = "../../../../assets/imgs/botoes/b_jogar.png"
            on = "../../../../assets/imgs/botoes/b_jogar_clicado.png"
        }
        spawn Botao(0.7, off, on, "personalizar") where
        {
            off = "../../../../assets/imgs/botoes/b_personalizar.png"
            on = "../../../../assets/imgs/botoes/b_personalizar_clicado.png"
        }
        spawn Botao(0.9, off, on, "sair") where
        {
            off = "../../../../assets/imgs/botoes/b_sair.png"
            on = "../../../../assets/imgs/botoes/b_sair_clicado.png"
        }
        await(false)
    }
}

Menu()