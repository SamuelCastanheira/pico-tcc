val Image = require "util/components/image"
val XClickable = require "util/components/xclickable"

task Cor(id, rect, path)
{
    set pub = [
        id = id,
        rect = rect
    ]

    spawn Image(id, rect, path)
    spawn XClickable(task)

    loop on :clicked
    {
        emit @(:global) :MUDA_COR [id = id]
    }
}

Cor