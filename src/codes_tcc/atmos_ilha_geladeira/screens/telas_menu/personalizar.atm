val Image = require "util/components/image"
val Image_Clickable_Non_Persistent = require "util/components/image_clickable_non_persistent"

task Personalizar () {
    cria_layer_quadro()

    spawn Image(:NIL,r, img) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1 ]
        img = "../../../assets/imgs/background_personalizar.png"
    }

    par:any {
        await (
            loop on :draw{
                pico.set.pencil [ color = 'white' ]
                pico.output.draw.text("Escolha sua cor",
                ['%', x=0.78, y=0.25, w=0.38, h=0.1])
            }
        )
     } with {
        spawn Image(:NIL,
        ['%', x=0.3, y=0.35, w=0.3, h=0],
        "../../../assets/imgs/personalizar/pinguim_amarelo.png")
        
        await Image_Clickable_Non_Persistent(
            :PERSON, 
            ['%', x=0.3, y=0.8, w=0.3, h=0],
            "../../../assets/imgs/botoes/b_voltar.png", 
            "../../../assets/imgs/botoes/b_voltar_clicado.png", 
        )
    } with{
        loop on :clock{
            mouse_em_cor()
        }
    }
}

val cores = [
    "amarelo",
    "avermelhado",
    "azul_forte",
    "ciano",
    "cinza",
    "azul_fraco",
    "laranja",
    "marrom",
    "preto", 
    "rosa_medio",
    "roxo",     
    "verde_forte",
    "verde_medio",
    "verde_vomito",
    "vermelho"
]

func mouse_em_cor(){
    var m = pico.get.mouse('%')
    loop i, cor in cores {
        set i = i - 1
        val v = ['%',
            x = 0.2 + ((i%5)*0.15),
            y = 0.25 + (math.floor(i/5)*0.15),
            w = 0.15,
            h = 0.15,
        ]

        if pico.vs.pos.rect(m, :quadro, v) {
            print(cor)
        } 
    }
}

func cria_layer_quadro(){
    pico.layer.empty [
        up     = :world,
        key    = :quadro,
        target = [ '%', x=0.78, y=0.5, w=0.4, h=0.5 ],
    ]

    pico.layer.image [
        up     = :quadro,
        path   = "../../../assets/imgs/personalizar/quadro.png",
        target = [ '%', x=0.5, y=0.5, w=1, h=1 ],
    ]
    
    loop i,cor in cores {
        set i = i - 1
        val cor = string.format("../../../assets/imgs/personalizar/%d.png", i) 
        pico.layer.image [
            up    = :quadro,
            path  = cor,
            target = ['%',
                x = 0.2 + ((i%5)*0.15),
                y = 0.25 + (math.floor(i/5)*0.15),
                w = 0.15,
                h = 0.15,
            ]
        ]
    }
}

Personalizar
