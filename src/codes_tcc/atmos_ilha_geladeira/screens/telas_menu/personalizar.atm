val Image = require "util/components/image"
val Botao = require "util/components/botao"

val cores = [
    "amarelo",
    "avermelhado",
    "azul_forte",
    "ciano",
    "cinza",
    "azul_fraco",
    "laranja",
    "marrom",
    "preto", 
    "rosa_medio",
    "roxo",     
    "verde_forte",
    "verde_medio",
    "verde_vomito",
    "vermelho"
]

task Personalizar () {
    cria_layer_quadro()

    spawn Image (:NIL,r, img) where {
        r = ['%', x=0.5, y=0.5, w=1, h=1]
        img = "../../../assets/imgs/background_personalizar.png"
    }

    var text = "Escolha sua cor"
    spawn {
        loop on :draw {
            pico.set.pencil [color = 'white']
            pico.output.draw.text.fix(text,
            ['%', x=0.78, y=0.25, w=0.38, h=0.1])
        }
    }

    spawn {
        loop {
            spawn Image(:NIL,r, img) where {
                r = ['%', x=0.3, y=0.35, w=0.3, h=0]
                base_pinguins = "../../../assets/imgs/personalizar/pinguim"
                img = string.format("%s_%s.png", base_pinguins, cor_pinguim)
            }
            await :mouse.button.dn
            var m = pico.get.mouse('%')
            loop i, cor in cores {
                val lay = string.format("../../../assets/imgs/personalizar/%d.png", i-1)
                if pico.vs.pos.rect(m, lay) {
                    set cor_pinguim = cor
                    break()
                } 
            }
        }
    }
    
    await Botao(
        :PERSON, 
        ['%', x=0.3, y=0.8, w=0.3, h=0],
        "../../../assets/imgs/botoes/b_voltar.png", 
        "../../../assets/imgs/botoes/b_voltar_clicado.png", 
    )
}

func cria_layer_quadro(){
    pico.layer.empty [
        up     = :world,
        key    = :quadro,
        target = [ '%', x=0.78, y=0.5, w=0.4, h=0.5 ],
    ]

    pico.layer.image [
        up     = :quadro,
        path   = "../../../assets/imgs/personalizar/quadro.png",
        target = [ '%', x=0.5, y=0.5, w=1, h=1 ],
    ]
    
    loop i,cor in cores {
        set i = i - 1
        val cor = string.format("../../../assets/imgs/personalizar/%d.png", i) 
        pico.layer.image [
            up    = :quadro,
            path  = cor,
            target = ['%',
                x = 0.2 + ((i%5)*0.15),
                y = 0.3 + (math.floor(i/5)*0.2),
                h = 0.2,
            ]
        ]
    }
}

Personalizar
