val Image = require "util/components/image"
val Text = require "util/components/text"
val Image_Clickable_Non_Persistent = require "util/components/image_clickable_non_persistent"

task Personalizar () {
    cria_layer_quadro()

    spawn Image (:NIL,r, img) where {
        r = ['%', x=0.5, y=0.5, w=1, h=1]
        img = "../../../assets/imgs/background_personalizar.png"
    }

    var text = "Escolha sua cor"
    spawn {
        loop on :draw {
            pico.set.pencil [color = 'white']
            pico.output.draw.text(text,
            ['%', x=0.78, y=0.25, w=0.38, h=0.1])
        }
    }

    spawn {
        loop
        {
            par :any {
                await :mouse.button.dn
                mouse_em_cor()
            } with {
                var cor = await :MUDA_COR
                set cor_pinguim = cor.id
            } with {

                val base_pinguins = "../../../assets/imgs/personalizar/pinguim"
                val path_pinguim = string.format("%s_%s.png", base_pinguins, cor_pinguim)

                spawn Image(:NIL,r, img) where {
                    r = ['%', x=0.3, y=0.35, w=0.3, h=0]
                    img = path_pinguim
                }
                await :MUDA_COR
            }
        }
    }
    
    await Image_Clickable_Non_Persistent(
        :PERSON, 
        ['%', x=0.3, y=0.8, w=0.3, h=0],
        "../../../assets/imgs/botoes/b_voltar.png", 
        "../../../assets/imgs/botoes/b_voltar_clicado.png", 
    )
}

val cores = [
    "amarelo",
    "avermelhado",
    "azul_forte",
    "ciano",
    "cinza",
    "azul_fraco",
    "laranja",
    "marrom",
    "preto", 
    "rosa_medio",
    "roxo",     
    "verde_forte",
    "verde_medio",
    "verde_vomito",
    "vermelho"
]

func mouse_em_cor(){
    var m = pico.get.mouse('%')
    loop i, cor in cores {
        set i = i - 1
        val layer_cor = string.format("../../../assets/imgs/personalizar/%d.png", i)
        
        if pico.vs.pos.rect(m, layer_cor) {
            set cor_pinguim = cor
            emit :MUDA_COR[id = cor]
        } 
    }
}

func cria_layer_quadro(){
    pico.layer.empty [
        up     = :world,
        key    = :quadro,
        target = [ '%', x=0.78, y=0.5, w=0.4, h=0.5 ],
    ]

    pico.layer.image [
        up     = :quadro,
        path   = "../../../assets/imgs/personalizar/quadro.png",
        target = [ '%', x=0.5, y=0.5, w=1, h=1 ],
    ]
    
    loop i,cor in cores {
        set i = i - 1
        val cor = string.format("../../../assets/imgs/personalizar/%d.png", i) 
        pico.layer.image [
            up    = :quadro,
            path  = cor,
            target = ['%',
                x = 0.2 + ((i%5)*0.15),
                y = 0.3 + (math.floor(i/5)*0.2),
                h = 0.2,
            ]
        ]
    }
}

Personalizar
