val GameState = require "consts/gameState"
val Image = require "util/image"
val Botao = require "util/botao"

func Menu () {
    set pub = @{
        nextScreen = nil
    }

    watching :end {
        spawn Image(r, img) where
        {
            r = @{ '%', x=0.5, y=0.5 }
            img = "../../../assets/imgs/background_menu.png"
        }

        spawn Image(r, img) where
        {
            r = @{ '%', x=0.5, y=0.225, w=0.45, h=0.45 }
            img = "../../../assets/imgs//logo.png"
        }
            
        pin jogar = spawn Botao(@{ '%', x=0.5, y=0.5, w=0.55, h=0.15 },
        "../../../assets/imgs/botoes/b_jogar.png",
        "../../../assets/imgs/botoes/b_jogar_clicado.png", 
        GameState.CENTRO) 
        
        pin person = spawn Botao(@{ '%', x=0.5, y=0.7, w=0.55, h=0.15 }, 
        "../../../assets/imgs/botoes/b_personalizar.png", 
        "../../../assets/imgs/botoes/b_personalizar_clicado.png", 
        GameState.PERSON)
        
        pin sair = spawn Botao(@{ '%', x=0.5, y=0.9, w=0.55, h=0.15 }, 
        "../../../assets/imgs/botoes/b_sair.png", 
        "../../../assets/imgs/botoes/b_sair_clicado.png", 
        GameState.SAIR) 
        
        every :clock
        {
            if jogar.pub.output || person.pub.output || sair.pub.output
            {
                set pub.nextScreen = jogar.pub.output || person.pub.output || sair.pub.output
                emit :end
            }
        }
    }
    pub.nextScreen
}

Menu