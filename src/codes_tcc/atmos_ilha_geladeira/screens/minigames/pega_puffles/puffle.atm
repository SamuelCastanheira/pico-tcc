val XCollidable = require "util/components/xcollidable"
val Image = require "util/components/image"
val Vetor = require "util/vetor"

task Puffle (rect, hitbox, cerca, paredes, img, dist_max, puffles) {
    set pub = [
        id = cor,
        rect = rect,
        hitbox = hitbox
    ]

    var vel_esc = 0.4
    var vel_vet = [x = 0 ,y = 0]

    var direcao = [x = 0, y = 0]

    ;; entrada e saida da cerca
    spawn {
        loop {
            loop on :clock {
                until (pico.vs.rect.rect(pub.rect, cerca))
            }
            emit @2 :puffle.entrou
            loop on :clock {
                until (!pico.vs.rect.rect(pub.rect, cerca))
            }
            emit @2 :puffle.saiu
        }
    }

    ;; movimento dos puffles
    spawn {
        par :all {
            loop p on :puffle.empurrado {
                set direcao = Vetor.add(direcao, p.dir_empurrao)
            }            
        } with {
            loop us on :clock {
                do {
                    var mouse = pico.get.mouse('%')
                    var delta = [x= mouse.x - pub.rect.x , y=mouse.y - pub.rect.y]
                    var dist = Vetor.magnitude(delta)

                    if ((dist > 0.001) && (dist <= dist_max)) {
                        val destino = [
                            x = mouse.x - (2 * delta.x),
                            y = mouse.y - (2 * delta.y)
                        ]
                        
                        set direcao = [
                            x = (destino.x - pub.rect.x),
                            y = (destino.y - pub.rect.y)
                        ]
                    } 
                }
                do {
                    val influencia = 0.5
                    loop _, outro in puffles {
                        if outro != task {
                            val delta = [x = outro.pub.rect.x - pub.rect.x, y = outro.pub.rect.y - pub.rect.y]

                            if (Vetor.magnitude(delta) < 0.05) && (Vetor.magnitude(delta) > 0) {
                                set direcao = Vetor.subtract(direcao, Vetor.multiply(delta,influencia))
                            }
                        }
                    }
                }
                do {
                    loop _,parede in paredes {
                        val col = pico.vs.rect.rect(pub.rect, parede)
                        if col {
                            val slide = slide_cerca(pub.rect, parede, direcao)
                            set direcao = Vetor.add(direcao, slide)
                        }
                    }
                }

                do {
                    set vel_vet= Vetor.multiply(
                        Vetor.normalize(direcao, vel_esc), 
                        vel_esc)
                    
                    val dt = us/1s
                    set pub.rect.x = pub.rect.x + (vel_vet.x * dt)
                    set pub.rect.y = pub.rect.y + (vel_vet.y * dt)
                    set pub.hitbox.x = pub.rect.x
                    set pub.hitbox.y = pub.rect.y

                    set direcao = [x = 0, y = 0]
                    set vel_vet = [x = 0, y = 0]
                }
            }
        }   
    } 

    ;; redesenho
    spawn {
        loop on :draw {
            pico.output.draw.image(img, pub.rect)
        }
    }

    ;; condicao de termino
    await until (fora_do_mapa(pub.rect))
    emit @2 :puffle.fugiu
}

func fora_do_mapa(rect) {
    val centro =[x = 0.5, y = 0.5]

    val rx = 1.53 / 2
    val ry = 0.9 / 2

    val dx = rect.x - centro.x
    val dy = rect.y - centro.y

    val valor =
        ((dx * dx) / (rx * rx)) +
        ((dy * dy) / (ry * ry))

    !((valor <= 1) && (rect.x < 1) && (rect.x > 0)) 
}

func slide_cerca(rect, parede, direcao) {
    var normal = [x=0, y=0]

    val dx = rect.x - parede.x
    val dy = rect.y - parede.y

    val overlapX = ((parede.w/2) + (rect.w/2)) - math.abs(dx)
    val overlapY = ((parede.h/2) + (rect.h/2)) - math.abs(dy)

    ;; colisão horizontal
    if overlapX < overlapY {
        if dx > 0 {
            set normal = [x=1, y=0]
        } else {
            set normal = [x=-1, y=0]
        }
    } else {
        ;; colisão vertical
        if dy > 0 {
            set normal = [x=0, y=1]
        } else {
            set normal = [x=0, y=-1]
        }
    }

    val dot = Vetor.dot(direcao,normal)

    if dot < 0 {
        set direcao.x = direcao.x - (dot * normal.x)
        set direcao.y = direcao.y - (dot * normal.y)
    }

    Vetor.multiply(direcao, 0.1)
}

Puffle
