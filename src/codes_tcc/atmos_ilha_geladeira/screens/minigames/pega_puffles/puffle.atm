val Vetor = require "util/vetor"

;; como no Lua: velocidade escalar e passo fixo por quadro
val VEL_ESC = 0.04
val DT = 0.05

;; Um puffle reage a duas fases de cada quadro, emitidas pela tela
;; (PegaPuffles), na mesma ordem do update do Lua:
;;   :puffle.direcao  calcula a direção com as posições de todos ainda paradas
;;   :puffle.anda     anda (ou foge, se já está fora do mapa)
task Puffle (rect, paredes, img, dist_max, puffles) {
    set pub = [
        rect = rect,
        fugiu = false,
    ]

    var direcao = [x = 0, y = 0]

    ;; fase 1: fuga do mouse, empurrão dos vizinhos, deslizamento na cerca
    spawn {
        loop on :puffle.direcao {
            set direcao = fuga_mouse(pub.rect, dist_max)

            ;; no Lua, cada puffle soma 0,5*(outro - ele) à direção do outro;
            ;; aqui cada puffle soma a si mesmo as contribuições dos vizinhos,
            ;; na mesma ordem: 0,5*(ele - vizinho)
            loop _, outro in puffles {
                if (outro != task) && (!outro.pub.fugiu) {
                    val delta = [x = outro.pub.rect.x - pub.rect.x, y = outro.pub.rect.y - pub.rect.y]
                    val dist = Vetor.magnitude(delta)
                    if (dist < 0.05) && (dist > 0) {
                        set direcao = Vetor.subtract(direcao, Vetor.multiply(delta, 0.5))
                    }
                }
            }

            loop _, parede in paredes {
                if pico.vs.rect.rect(pub.rect, parede) {
                    set direcao = slide_cerca(pub.rect, parede, direcao)
                }
            }
        }
    }

    ;; redesenho
    spawn {
        loop on :draw {
            pico.output.draw.image(img, pub.rect)
        }
    }

    ;; fase 2: o puffle que já está fora do mapa foge (como no Lua, o teste
    ;; vem antes de andar); os outros andam um passo na direção do quadro
    loop on :puffle.anda {
        until (fora_do_mapa(pub.rect))
        val vel = Vetor.multiply(Vetor.normalize(direcao), VEL_ESC)
        set pub.rect.x = pub.rect.x + (vel.x * DT)
        set pub.rect.y = pub.rect.y + (vel.y * DT)
    }
    set pub.fugiu = true
    emit @2 :puffle.fugiu
}

;; foge do mouse quando ele está a até dist_max: a direção é -(mouse - puffle)
func fuga_mouse (rect, dist_max) {
    val mouse = pico.get.mouse('%')
    val delta = [x = mouse.x - rect.x, y = mouse.y - rect.y]
    val dist = Vetor.magnitude(delta)
    if (dist > 0.001) && (dist <= dist_max) {
        val destino = [
            x = mouse.x - (2 * delta.x),
            y = mouse.y - (2 * delta.y)
        ]
        [x = destino.x - rect.x, y = destino.y - rect.y]
    } else {
        [x = 0, y = 0]
    }
}

func fora_do_mapa(rect) {
    val centro =[x = 0.5, y = 0.5]

    val rx = 1.53 / 2
    val ry = 0.9 / 2

    val dx = rect.x - centro.x
    val dy = rect.y - centro.y

    val valor =
        ((dx * dx) / (rx * rx)) +
        ((dy * dy) / (ry * ry))

    !((valor <= 1) && (rect.x < 1) && (rect.x > 0))
}

;; como o aplicar_slide do Lua: tira a componente que entra na parede e
;; reduz a direção a 10%
func slide_cerca(rect, parede, direcao) {
    var normal = [x=0, y=0]

    val dx = rect.x - parede.x
    val dy = rect.y - parede.y

    val overlapX = ((parede.w/2) + (rect.w/2)) - math.abs(dx)
    val overlapY = ((parede.h/2) + (rect.h/2)) - math.abs(dy)

    ;; colisão horizontal
    if overlapX < overlapY {
        if dx > 0 {
            set normal = [x=1, y=0]
        } else {
            set normal = [x=-1, y=0]
        }
    } else {
        ;; colisão vertical
        if dy > 0 {
            set normal = [x=0, y=1]
        } else {
            set normal = [x=0, y=-1]
        }
    }

    var d = [x = direcao.x, y = direcao.y]
    val dot = Vetor.dot(d, normal)
    if dot < 0 {
        set d.x = d.x - (dot * normal.x)
        set d.y = d.y - (dot * normal.y)
    }

    Vetor.multiply(d, 0.1)
}

Puffle
