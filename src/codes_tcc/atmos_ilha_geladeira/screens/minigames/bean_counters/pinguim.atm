val Image = require "util/components/image"
val XCollidable = require "util/components/xcollidable"

task Pinguim(id, rect, hitbox, cargas) {
    set pub = [
        rect = rect,
        hitbox = hitbox,
        cargas = 0,
    ]

    var vidas = 3
    var vel = 0 
    var img = "../../../assets/imgs/bean_counters/penguin0.webp"
    val carga_maxima = 5

    pin colis_c = spawn XCollidable(task, cargas)

    spawn {
        loop {
            val c = await :collided
            match c.id {
                :Anvil => emit :colid_anvil
                :Flower_pot => emit :colid_flower
                :Coffe_bag => emit :colid_coffe
                :Fish_bean_counters => emit :colid_fish
            } 
        }
    }

    spawn {
        par :any {
            loop {
                await :colid_coffe
                set img = "../../../assets/imgs/bean_counters/penguin0.webp"

                loop _ in 5 {
                    await :colid_coffe
                    set img = string.format("../../../assets/imgs/bean_counters/penguin%d.webp",i)
                }
                emit @(me) :limite_carga
            }   
        } with { 
            loop {
                par :any {
                    await :colid_flower 
                    set img = "../../../assets/imgs/bean_counters/penguin_pot.webp"
                } with {
                    await :colid_fish 
                    set img = "../../../assets/imgs/bean_counters/penguin_fish.webp"
                }with {
                    await :colid_anvil
                    set img = "../../../assets/imgs/bean_counters/penguin_anvil.webp"
                }
                await 3s
            }
        }
    }

    watching until (vidas == 0) {
        par :any {
            var dt = 0
            par :any {
                loop {
                    val us = await :clock
                    set dt = us/1s
                }
            } with {
                loop{
                    par :any {
                        await :key.dn until it.key == :Right
                        set vel = 7
                    } with {
                        await :key.dn until it.key == :Left
                        set vel = -7
                    }
                    var new_x = pub.rect.x + (vel*((carga_maxima - pub.cargas)/carga_maxima) * dt)
                    if new_x < 0.25 {  
                        set new_x = 0.25
                    }
                    else {
                        if new_x > 0.8 {
                            set new_x = 0.8
                        }
                    }
                    set pub.rect.x = new_x
                }
            }
        } with {
            loop on :draw {
                pico.output.draw.image(img, pub.rect)
            }
        }
    } 
}

Pinguim