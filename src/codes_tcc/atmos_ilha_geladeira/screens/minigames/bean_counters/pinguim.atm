val Image = require "util/components/image"
val XCollidable = require "util/components/xcollidable"

task Pinguim(id, rect, hitbox, ts) {
    set pub = [
        rect = rect,
        hitbox = hitbox,
        vidas = 3
    ]

    var vel = 0 
    var img 
    val carga_maxima = 6
    var carga = 0

    pin colis_c = spawn XCollidable(task, ts@1)
    pin colis_p = spawn XCollidable(task, ts@2)

    spawn {
        loop{
            set carga = 0
            set img = string.format("../../../assets/imgs/bean_counters/penguin%d.webp",carga)
            par :any {

                pin spawn_plataforma = spawn {
                    loop
                    {
                        await <:collided until (it.id.pub.tipo==:Plataforma)>
                        if carga > 0 { 
                            emit @(2) :pinguim.entrega
                            set carga = carga -1
                            set img = string.format("../../../assets/imgs/bean_counters/penguin%d.webp",carga)
                            emit @(:global) :pinguim.colid_plataforma
                            await 250ms
                        }
                    }
                }

                spawn {
                    loop {
                        await <:collided until (it.id.pub.tipo==:Coffe_bag)>
                        toggle spawn_plataforma(false)
                        await 250ms
                        toggle spawn_plataforma(true)
                    }
                }

                loop {
                    until (carga >= carga_maxima)
                    val c = await <:collided until (it.id.pub.tipo==:Coffe_bag)>
                    emit @(2) :pinguim.coleta
                    emit @(c.id) :collided 
                    set carga = carga + 1
                    set img = string.format("../../../assets/imgs/bean_counters/penguin%d.webp",carga)
                }

            } with {

                val c = await <:collided until (it.id.pub.tipo==:Flower_pot)> 
                emit @(c.id) :collided
                set img = "../../../assets/imgs/bean_counters/penguin_pot.webp"

            } with {

                val c = await <:collided until (it.id.pub.tipo==:Fish_bean_counters)> 
                emit @(c.id) :collided 
                set img = "../../../assets/imgs/bean_counters/penguin_fish.webp"

            }with {

                val c = await <:collided until (it.id.pub.tipo==:Anvil)> 
                emit @(c.id) :collided
                set img = "../../../assets/imgs/bean_counters/penguin_anvil.webp"
            }

            set pub.vidas = pub.vidas - 1
            set pub.rect.h = 0.15
            emit @(2) :pinguim.atordoado
            emit :pinguim.atordoado
            await 2s
            set pub.rect.h = 0.25
        }
    }

    ;;atualiza movimento
    spawn {
        loop{
            watching :pinguim.atordoado {
                loop {
                    par :any {
                        await :key.dn until (it.key == :Right)
                        set vel = 10 * ((carga_maxima - carga)/carga_maxima)
                    } with {
                        await :key.dn until (it.key == :Left)
                        set vel = -10 * ((carga_maxima - carga)/carga_maxima)
                    }
    
                    var new_x = pub.rect.x + (vel* (1/60))
                    if new_x < 0.25 {  
                        set new_x = 0.25
                    }
                    else {
                        if new_x > 0.8 {
                            set new_x = 0.8
                        }
                    }
                    set pub.rect.x = new_x
                    set pub.hitbox.x = new_x
                }
            }
            await 2s
        }
    }
    
    ;;redesenho
    loop on :draw {
        pico.output.draw.image(img, pub.rect)
    }
}

Pinguim