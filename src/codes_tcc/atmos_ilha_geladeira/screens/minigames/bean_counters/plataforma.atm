val Pilha = require "screens/minigames/bean_counters/pilha"

task Plataforma(rect, img) {
    spawn Image(:NIL, rect, img)

    set pub = [
        id = task,
        rect = rect,
        hitbox = rect,
        tipo = :Plataforma
    ]

    pin pilha1 = spawn Pilha(0.1, 0.85, 10)
    pin pilha2 = spawn Pilha(0.15, 0.85, 10)

    spawn {
        await :pilha.cheia
        await :pilha.cheia
        emit @(2) :plataforma.cheia
    }

    loop on :pinguim.colid_plataforma {
        if (pilha1.pub.qnt + 1) <= pilha1.pub.qnt_max {
            emit @(pilha1) :plataforma.entrega
        } else {
            if  (pilha2.pub.qnt + 1) <= pilha2.pub.qnt_max {
                emit @(pilha2) :plataforma.entrega
            }
        }
    } 
}

Plataforma