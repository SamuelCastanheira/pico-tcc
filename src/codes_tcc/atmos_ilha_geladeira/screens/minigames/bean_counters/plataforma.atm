val Pilha = require "screens/minigames/bean_counters/pilha"

task Plataforma(rect, img) {
    spawn Image(:NIL, rect, img)

    set pub = [
        id = task,
        rect = rect,
        hitbox = rect,
        tipo = :Plataforma
    ]
    pin pilha1 = spawn Pilha(0.1, 0.85)
    pin pilha2 = spawn Pilha(0.15, 0.85)

    spawn {
        await :pilha_cheia
        print("p1")
        await :pilha_cheia
        print("p2")
        emit @(:global) :plataforma_cheia
        print("p")
    }

    loop on :colid_plataforma {
        if (pilha1.pub.qnt + 1) <= pilha1.pub.qnt_max {
            emit @(pilha1) :entrega_coffe
        } else {
            if  (pilha2.pub.qnt + 1) <= pilha2.pub.qnt_max {
                emit @(pilha2) :entrega_coffe
            }
        }
    } 
}

Plataforma