val tipos = [
    "Anvil",
    "Flower_pot",
    "Coffe_bag",
    "Fish_bean_counters"
]

task Carga(id, rect, hitbox) {
    
    set pub = [
        rect = rect,
        hitbox = hitbox,
        id = tipos@(math.random(1,#tipos))
    ]
    
    val base = "../../../assets/imgs/bean_counters"
    val img = string.format("%s/%s.webp", base, pub.tipo)

    pico.layer.image[path=img]
    
    par :any {
        await :collided
    } with {
        watching until pub.rect.y > 0.9 {
            loop on :draw {
                if pub.id != :Anvil {
                    
                }
            }
        }
    }
}

Carga