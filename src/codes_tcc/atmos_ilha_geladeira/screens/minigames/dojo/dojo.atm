val Image = require "util/components/image"
val Carta = require "screens/minigames/dojo/carta"

val num_cartas = 3

val cartas = [
    [   elem = :AGUA, 
        power = 3, 
        img="../../../assets/imgs/dojo/agua_3.png"],
    
    [   elem = :FOGO,
        power = 4, 
        img="../../../assets/imgs/dojo/fogo_4.png"],
    
    [  elem = :FOGO, 
        power = 7, 
        img="../../../assets/imgs/dojo/fogo_7.png"],
    
    [   elem = :GELO, 
        power=5, 
        img="../../../assets/imgs/dojo/gelo_5.png"],
    
    [   elem =  :GELO, 
        power =6, 
        img="../../../assets/imgs/dojo/gelo_6.png"]
]

task Dojo(){
    var player_wins = 0
    var enemy_wins = 0

    spawn Image(:NIL, r, img) where
    {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../../assets/imgs/dojo/background.png"
    }

    pin playerDeck = tasks(num_cartas)
    sorteiaCartas(true, playerDeck)
    pin enemyDeck = tasks(num_cartas)
    sorteiaCartas(false, enemyDeck)

   
    loop in num_cartas{
        ;;escolha da carta do player
        val player_card = await :player.chose 

        ;;escolha imediata da carta do inimigo
        val idx = math.random(1, #enemyDeck)
        var enemy_card
        loop i,card in enemyDeck {
            if i == idx {
                set enemy_card = card
            }
        }
        
        ;;atualiza posicoes das cartas na mesa
        ordenaCartas(true, playerDeck, player_card.ref)
        ordenaCartas(false, enemyDeck, enemy_card)
                
        val resul = comparaCartas(player_card, enemy_card)
        
        ifs {
            (resul > 0) => set player_wins = player_wins + 1
            (resul < 0) => set enemy_wins = enemy_wins + 1
        }

        emit @(player_card.ref) :present [resul = resul]
        emit @(enemy_card) :present [resul = -resul]

        await 2s 
    }
    
    set moedas = moedas + ifs {
        player_wins > enemy_wins =>  100
        player_wins == enemy_wins =>  50
    }
}

func ordenaCartas(player, deck, carta) {
    var x = if player => 0.9 => 0.1
    var dir = if player => -1 => 1
    var cont = 0
    loop i,c in deck {
        if carta != c
        {
            set c.pub.rect = ['%', x = x + (dir*cont * 0.12), y = 0.88, w = 0.1, h = 0.2]
            set cont = cont + 1
        }
    }
}

func sorteiaCartas(player, deck) {
    var x = if player => 0.9 => 0.1
    var dir = if player => -1 => 1 
    var i = 0
    var idx
    var cartas_sort = []
        loop {
            until (#deck == num_cartas)
            set idx = math.random(1, #cartas)
            if !cartas_sort@idx {
                set cartas_sort@idx = true
                val carta = cartas@idx
                
               spawn @(deck) Carta(task, player, 
                ['%', x = x + (dir*#deck* 0.12), y = 0.88, w = 0.1, h = 0.2],
                carta.img, 
                carta.elem, 
                carta.power)
            }
    }
}

func comparaCartas(p, e) {
    var resul = -1
    if p.elem == e.elem {
        if p.power > e.power { 
            set resul = 1
        }
        if p.power < e.power { 
           set resul = -1
        }
        else {
            set resul = 0
        }
    }
    
    if ((p.elem == "GELO") && (e.elem == "AGUA")) ||
       ((p.elem == "AGUA") && (e.elem == "FOGO")) ||
       ((p.elem == "FOGO") && (e.elem == "GELO")) {
        set resul = 1
    }
    else {
        set resul = 1
    }
    return(resul)
}

Dojo
