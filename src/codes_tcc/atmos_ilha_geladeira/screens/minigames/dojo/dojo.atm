val Image = require "util/components/image"
val Carta = require "screens/minigames/dojo/carta"

val num_cartas = 3

val cartas = [  
    [   elem = :FOGO,
        power = 4, 
        img="../../../assets/imgs/dojo/fogo_4.png"],
    
    [  elem = :FOGO, 
        power = 7, 
        img="../../../assets/imgs/dojo/fogo_7.png"],
    
    [   elem = :GELO, 
        power= 5, 
        img="../../../assets/imgs/dojo/gelo_5.png"],
    
    [   elem = :GELO, 
        power = 6, 
        img="../../../assets/imgs/dojo/gelo_6.png"]
]

task Dojo(){
    var player_wins = 0
    var enemy_wins = 0

    spawn Image(:NIL, r, img) where
    {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../../assets/imgs/dojo/background.png"
    }

    pin playerDeck = tasks(num_cartas)
    sorteiaCartas(:player, playerDeck)
    pin enemyDeck = tasks(num_cartas)
    sorteiaCartas(:enemy, enemyDeck)

   
    loop in num_cartas{
        ;;escolha da carta do player
        val player_card = await :clicked

        ;;escolha imediata da carta do inimigo
        val idx = math.random(1, #enemyDeck)
        var enemy_card
        loop i,card in enemyDeck {
            if i == idx {
                set enemy_card = card
            }
        }
        
        ;;atualiza posicoes das cartas na mesa
        ordenaCartas(:player, playerDeck, player_card.me)
        ordenaCartas(:enemy, enemyDeck, enemy_card)
                
        val resul = comparaCartas(player_card.me, enemy_card)
        
        ifs {
            (resul > 0) => set player_wins = player_wins + 1
            (resul < 0) => set enemy_wins = enemy_wins + 1
        }

        emit @(player_card.me) :present [resul = resul]
        emit @(enemy_card) :present [resul = -resul]

        await 2s 
    }
    
    set moedas = moedas + ifs {
        player_wins > enemy_wins =>  100
        player_wins == enemy_wins =>  50
        else => 0
    }
}

func ordenaCartas(id, deck, carta) {
    var x = if (id == :player) => 0.9 => 0.1
    var dir = if (id == :player) => -1 => 1
    var cont = 0
    loop i,c in deck {
        if carta != c
        {
            set c.pub.rect = ['%', x = x + (dir*cont * 0.12), y = 0.88, w = 0.1, h = 0.2]
            set cont = cont + 1
        }
    }
}

func sorteiaCartas(id, deck) {
    var x = if (id == :player) => 0.9 => 0.1
    var dir = if (id == :player) => -1 => 1 
    var i = 0
    var idx
    var cartas_sort = []
        loop {
            until (#deck == num_cartas)
            set idx = math.random(1, #cartas)
            if !cartas_sort@idx {
                set cartas_sort@idx = true
                val carta = cartas@idx
                
               spawn @(deck) Carta(id, 
                ['%', x = x + (dir*#deck* 0.12), y = 0.88, w = 0.1, h = 0.2],
                carta.img, 
                carta.elem, 
                carta.power)
            }
    }
}

func comparaCartas(p, e) {
    var resul = -1
    if p.pub.elem == e.pub.elem {
        if p.pub.power > e.pub.power { 
            set resul = 1
        }
        else {
            if p.pub.power < e.pub.power { 
                set resul = -1
            } 
            else {
                set resul = 0
            }
        }
    }
    else {
        if ((p.pub.elem == "GELO") && (e.pub.elem == "AGUA")) ||
        ((p.pub.elem == "AGUA") && (e.pub.elem == "FOGO")) ||
        ((p.pub.elem == "FOGO") && (e.pub.elem == "GELO")) {
            set resul = 1
        }
        else {
            set resul = -1
        }
    }
    return(resul)
}

Dojo
