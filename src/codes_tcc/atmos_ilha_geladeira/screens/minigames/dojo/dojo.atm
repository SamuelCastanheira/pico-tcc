val Image = require "util/components/image"
val Carta = require "screens/minigames/dojo/carta"

val num_cartas = 3

val cartas = [
    [   elem = :AGUA, 
        power = 3, 
        img="../../../assets/imgs/dojo/agua_3.png"],
    
    [   elem = :FOGO,
        power = 4, 
        img="../../../assets/imgs/dojo/fogo_4.png"],
    
    [  elem = :FOGO, 
        power = 7, 
        img="../../../assets/imgs/dojo/fogo_7.png"],
    
    [   elem = :GELO, 
        power=5, 
        img="../../../assets/imgs/dojo/gelo_5.png"],
    
    [   elem =  :GELO, 
        power =6, 
        img="../../../assets/imgs/dojo/gelo_6.png"]
]

task Dojo(){
    var player_wins = 0
    var enemy_wins = 0

    spawn Image(:NIL, r, img) where
    {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../../assets/imgs/dojo/background.png"
    }

    pin playerDeck = tasks(num_cartas)
    sorteiaCartas(true, playerDeck)
    pin enemyDeck = tasks(num_cartas)
    sorteiaCartas(false, enemyDeck)

    watching :finalizado {
        loop{
            var p
            var e
            var r

            par :all
            {
                set e = await :enemy_chose
            } with {
                var sorted_indx = math.random(1, #enemyDeck)
                var card
                loop i,c in enemyDeck {
                    if i==sorted_indx {
                        set carta = c
                    }
                }
                emit @(carta) :make_enemy_chose
            } with {
                set p = await :player_chose
            }

            ordenaCartas(true, playerDeck, p.id)
            ordenaCartas(false, enemyDeck, e.id)

            par :all {
                set r = await :resultado
            } with {
                comparaCartas(task,p,e)
            }

            ifs{
                r.resul > 0 => set player_wins = player_wins + 1
                r.resul < 0 => set enemy_wins = enemy_wins + 1
            }

            emit @(p.id) :present [resul = r.resul]
            emit @(e.id) :present [resul = -r.resul]

            await 2s
            if #playerDeck == 0 => emit :finalizado 
        }
    }
    ifs{
        player_wins > enemy_wins => set moedas = moedas + 100
        player_wins == enemy_wins => set moedas = moedas + 50
    }
}

func ordenaCartas(player, deck, carta){
    var x = if player => 0.9 => 0.1
    var dir = if player => -1 => 1
    var cont = 0
    loop i,c in deck {
        if carta != c
        {
            set c.pub.rect = ['%', x = x + (dir*cont * 0.12), y = 0.88, w = 0.1, h = 0.2]
            set cont = cont + 1
        }
    }
}

func sorteiaCartas(player, deck) {
    var x = if player => 0.9 => 0.1
    var dir = if player => -1 => 1 
    var i = 0
    var idx
    var cartas_sort = []
        loop {
            until (#deck == num_cartas)
            set idx = math.random(1, #cartas)
            if !cartas_sort@idx {
                set cartas_sort@idx = true
                val carta = cartas@idx
                
               spawn @(deck) Carta(task, player, 
                ['%', x = x + (dir*#deck* 0.12), y = 0.88, w = 0.1, h = 0.2],
                carta.img, 
                carta.elem, 
                carta.power)
            }
    }
}

func comparaCartas(me, p, e){
    if p.elem == e.elem {
        if p.power > e.power { 
            emit @(me) :resultado [resul = 1]
        }
        if p.power < e.power { 
            emit @(me) :resultado [resul = -1] 
        }
        else {
            emit @(me) :resultado [resul = 0]
        }
    }
    
    if ((p.elem == "GELO") && (e.elem == "AGUA")) ||
       ((p.elem == "AGUA") && (e.elem == "FOGO")) ||
       ((p.elem == "FOGO") && (e.elem == "GELO")) {
        emit @(me) :resultado [resul = 1]
    }
    else {
        emit @(me) :resultado [resul = -1]
    }
}

Dojo
