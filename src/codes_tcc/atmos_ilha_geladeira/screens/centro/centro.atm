val Image = require "util/image"
val Objeto = require "util/objeto"

func Centro(){
    set pub = @{
        nextScreen = nil
    }

    watching :end
    {
        spawn Image(r, img) where
        {
            r = @{ '%', x=0.5, y=0.5 }
            img = "../../../assets/imgs/centro.png"
        }
        
        pin cafeteria = spawn Objeto(@{'%', x=0.25, y=0.4, w=0.4, h=0.4},
            "../../../assets/imgs/coffe.png",
            "../../../assets/imgs/coffe_hover.png",
            GameState.BEAN_COUNTERS)

        pin dojo = spawn Objeto(@{'%', x=0.72, y=0.39, w=0.35, h=0.35},
            "../../../assets/imgs/dojo/dojo.png",
            "../../../assets/imgs/dojo/dojo_hover.png",
            GameState.DOJO)

        pin petshop = spawn Objeto(@{'%', x=0.5, y=0.4, w=0.35, h=0.35},
            "../../../assets/imgs/pet_shop.png",
            "../../../assets/imgs/pet_shop_hover.png",
            GameState.PEGA_PUFLES)
        
        every :clock
        {
            if petshop.pub.output || dojo.pub.output || cafeteria.pub.output
            {
                set  pub.nextScreen = petshop.pub.output || dojo.pub.output || cafeteria.pub.output
                emit :end
            }
        }
    }
    set v = pub.nextScreen
    print (v)
    match v
    {

    }
}
 Centro



