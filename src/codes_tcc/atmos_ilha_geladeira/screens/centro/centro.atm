val Image = require "util/components/image"
val Pinguim = require "screens/centro/pinguim"
val Predio = require "screens/centro/predio"
val Dojo = require "screens/minigames/dojo/dojo"
val BeanCounters = require "screens/minigames/bean_counters/bean_counters"
val PegaPuffles = require "screens/minigames/pega_puffles/pega_puffles"

task Centro(){
    spawn Image(:NIL, r, img) where
    {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../../assets/imgs/centro.png"
    }

    spawn Moeda()

    pin predios = tasks(3)

    spawn @predios Predio(:BEAN_COUNTERS,
        ['%', x=0.20, y=0.4, w=0.4, h=0.4],
        ['%', x=0.20, y=0.4, w=0.21, h=0.21],
        "../../../assets/imgs/coffe.png",
        "../../../assets/imgs/coffe_hover.png")
    
    spawn @predios Predio(:DOJO, 
        ['%', x=0.72, y=0.39, w=0.35, h=0.35],
        ['%', x=0.72, y=0.39, w=0.21, h=0.21],
        "../../../assets/imgs/dojo/dojo.png",
        "../../../assets/imgs/dojo/dojo_hover.png")

    spawn @predios Predio(:PEGA_PUFLES,
        ['%', x=0.5, y=0.4, w=0.35, h=0.35],
        ['%', x=0.5, y=0.4, w=0.21, h=0.21],
        "../../../assets/imgs/pet_shop.png",
        "../../../assets/imgs/pet_shop_hover.png")
    
    pin p = spawn Pinguim(
        ['%', x=0.5, y=0.7, w=0.08, h=0.2],
        ['%', x=0.5, y=0.7, w=0.08, h=0.1],
        "amarelo",
        predios)

    val v = await(p)
    match v
    {
        :BEAN_COUNTERS => await BeanCounters()
        :DOJO => await Dojo()
        :PEGA_PUFLES => await PegaPuffles()
    } 
}

task Moeda()
{
    spawn Image(:NIL, r ,img) where{
    r = ['%',x=0.05, y=0.05, w=0.05, h=0]
    img = "../../../assets/imgs/moeda.png"}

    loop on :draw
    {
        var moeda_num = ['%',x=0.08, y=0, w=0.025*#tostring(moedas), h= 0.1, anchor='NW']
        pico.set.pencil [ color='yellow' ]
        pico.output.draw.text(moedas, moeda_num)
    } 
}

Centro
