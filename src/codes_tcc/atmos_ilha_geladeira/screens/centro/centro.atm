val Image = require "util/image"
val Image_Clickable_Persistent = require "util/image_clickable_persistent"
val Pinguim = require "screens/centro/pinguim"

func Centro(){
    spawn Image(:NIL, r, img) where
    {
        r = @{ '%', x=0.5, y=0.5 }
        img = "../../../assets/imgs/centro.png"
    }

    pin predios = tasks(3)

    spawn [predios] Image_Clickable_Persistent(:BEAN_COUNTERS,
        @{'%', x=0.25, y=0.4, w=0.4, h=0.4},
        "../../../assets/imgs/coffe.png",
        "../../../assets/imgs/coffe_hover.png")
    
    spawn [predios] Image_Clickable_Persistent(:DOJO, 
        @{'%', x=0.72, y=0.39, w=0.35, h=0.35},
        "../../../assets/imgs/dojo/dojo.png",
        "../../../assets/imgs/dojo/dojo_hover.png")

    spawn [predios] Image_Clickable_Persistent(:PEGA_PUFLES,
        @{'%', x=0.5, y=0.4, w=0.35, h=0.35},
        "../../../assets/imgs/pet_shop.png",
        "../../../assets/imgs/pet_shop_hover.png")
    
    spawn{
        every :clock
        {
            loop _,predio in predios{
                if predio.pub.click{
                    set dest = predio.pub.id
                }
            }
        }
    }

    val v = await Pinguim(:NONE,
        @{'%', x=0.5, y=0.7, w=0.08, h=0},
        "amarelo",
        predios, dest)

    match v
    {
        :BEAN_COUNTERS => print("1")
        :DOJO => print("2")
        :PEGA_PUFLES => print("3")
    } 
}

 Centro
