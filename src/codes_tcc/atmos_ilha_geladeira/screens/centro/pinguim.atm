val Image = require "util/components/image"
val XCollidable = require "util/components/xcollidable"
val Vetor = require "util/vetor"

func get_direcao (vel) {
    var setor = 0
    if Vetor.magnitude(vel) != 0{
        var ang = Vetor.angle(vel)
        set setor = math.floor((ang + (math.pi/8)) / (math.pi/4)) % 8
    }
    (90 - (setor*45)) % 360
}

func get_img (cor, vel) {
    var base = "../../../assets/imgs/pinguim"
    var direcao = get_direcao(vel)
    string.format("%s/%s/%03d.png", base, cor_pinguim, direcao) 
}

task Pinguim (rect, hitbox, cor, predios) {
    set pub = [
        hitbox = hitbox,
        rect = rect,
        dest = false,
    ]

    var vel  = [x=0, y=0]
    pin colis = spawn XCollidable(task, predios)

    spawn{
        loop {
            val d = await :DEFINE_DESTINO
            set pub.dest = d.id 
        }
    }

    watching :collided until it.id==pub.dest{
        par {
            await :mouse.button.dn
            loop {
                var ponto = pico.get.mouse('%')
                var delta = [x=ponto.x -pub.rect.x, y=ponto.y -pub.rect.y]
                set vel = Vetor.multiply(Vetor.normalize(delta), 0.2)

                watching :mouse.button.dn {
                    var d = [x=ponto.x -pub.rect.x, y=ponto.y -pub.rect.y]

                    watching until Vetor.magnitude(d) <= 0.01  {

                        loop us on :clock {
                            var dt = us/1s
                            set pub.rect.x = pub.rect.x + (vel.x * dt)
                            set pub.rect.y = pub.rect.y + (vel.y * dt)
                            set pub.hitbox.x = pub.rect.x
                            set pub.hitbox.y = pub.rect.y
                            set d = [x=ponto.x -pub.rect.x, y=ponto.y -pub.rect.y]
                        }
                    }
                    await(false)
                }
            }
        } with {
            loop on :draw {
                var path = get_img(cor,vel)
                pico.output.draw.image(path, pub.rect)
            }
        }
    }
    pub.dest
}

Pinguim
