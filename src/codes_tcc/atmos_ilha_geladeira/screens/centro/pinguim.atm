val Image_Collidable = require "util/image_collidable"
val Vetor = require "util/vetor"

func Pinguim(id, rect, on, off, others)
{
    var vel  = @{x=0, y=0}
    pin image = spawn Image_Collidable(id, rect, off, on, others)

    par_or{
            every :mouse.button.dn{
                var ponto = pico.get.mouse('%')
                var delta = @{x=ponto.x -rect.x, y=ponto.y -rect.y}
                set dest = ponto
                set vel = Vetor.multiply(Vetor.normalize(delta), 0.2)
                emit :MOVENDO
            } 
    }
    with{
        every :clock
        {
            if dest
            {
                var d = @{x=dest.x -rect.x, y=dest.y -rect.y}
                if Vetor.magnitude(d)>0.01{
                    emit :MOVENDO
                }
            }
        }
    }
    with{
            every _,ms in :clock {
                await :MOVENDO
                var dt = ms/1000
                set rect.x = rect.x + (vel.x * dt)
                set rect.y = rect.y + (vel.y * dt)
            }
    }with{
        loop{
            await :clock
            if (image.pub.collided){
                break()
            }
        }
    }
    image.pub.collided
}

Pinguim
