val Image_Hover = require "util/components/image_hover"
val XClickable = require "util/components/xclickable"

;;nao consegui usar global

task Predio(id, rect, off, on_)
{
    set pub = [
        id = id,
        rect = rect
    ]

    spawn Image_Hover(id, rect, off, on_)
    spawn XClickable(task)

    loop on :clicked
    {
        emit @(global) :DEFINE_DESTINO [id = id]
    }
}

Predio