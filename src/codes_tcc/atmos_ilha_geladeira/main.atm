require "atmos.env.pico"
set pico = require "pico"

set W, H = (1280, 720)

pico.set.window [ title="Ilha da Geladeira" ]
pico.set.dim ['!', w=1280, h=720]

math.randomseed()

val Menu = require "screens/telas_menu/menu"
val Centro = require "screens/centro/centro"
val Personalizar = require "screens/telas_menu/personalizar"

set moedas = 0

loop {
    var v = await Menu()
    match v {
        :CENTRO => await Centro()
        :PERSON => await Personalizar()
        :SAIR   => break()
    }
}
