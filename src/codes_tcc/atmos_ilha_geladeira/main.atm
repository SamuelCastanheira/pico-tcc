require "atmos.env.pico"
set pico = require "pico"

set W, H = (1280, 720)

pico.zet.window @{ title="Ilha da Geladeira" }
pico.zet.dim @{'!', w=1280, h=720}

math.randomseed()

val Menu = require "screens/telas_menu/menu"
val Centro = require "screens/centro/centro"
val GameState = require "consts/gameState"

loop {
    print("oi")
    val v = await Menu()
    print(v)
    match v
    {
        :GameState.CENTRO => await Centro()
    }
    await(false)
}