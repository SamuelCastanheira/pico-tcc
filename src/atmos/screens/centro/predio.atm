val Image_Hover = require "util/components/image_hover"
val XClickable = require "util/components/xclickable"

;; imagem clicável com destaque; o clique vai para "alvo"
task Predio (id, rect, hitbox, off, on_, alvo) {
    set pub = [
        id = id,
        rect = rect,
        hitbox = hitbox,
    ]
    spawn Image_Hover(rect, off, on_)
    spawn XClickable(alvo, task)
    await(false)
}

Predio
