val Image = require "util/components/image"
val XCollidable = require "util/components/xcollidable"
val Vetor = require "util/vetor"

func get_direcao (vel) {
    var setor = 2       ;; parado: virado para o sul ("000"), como no Lua
    if Vetor.magnitude(vel) != 0{
        var ang = Vetor.angle(vel)
        set setor = math.floor((ang + (math.pi/8)) / (math.pi/4)) % 8
    }
    (90 - (setor*45)) % 360
}

;; cores que têm sprites do centro (assets/imgs/pinguim); as outras usam o amarelo
val COM_SPRITE = [
    amarelo=true, azul_forte=true, azul_fraco=true, cinza=true, laranja=true,
    marrom=true, preto=true, rosa_medio=true, roxo=true, verde_forte=true,
    verde_medio=true, verde_vomito=true,
]

func get_img (vel) {
    var base = "../../assets/imgs/pinguim"
    var direcao = get_direcao(vel)
    val c = if COM_SPRITE@(cor_pinguim) => cor_pinguim => "amarelo"
    string.format("%s/%s/%03d.png", base, c, direcao) 
}

task Pinguim (rect, hitbox, predios) {
    set pub = [
        hitbox = hitbox,
        rect = rect,
        dest = false,
    ]

    var vel  = [x=0, y=0]
    spawn XCollidable(task, task, predios)

    spawn {
        loop c on :clicked {
            set pub.dest = c.me.pub.id 
        }
    }

    watching :collided until (it.oth.pub.id==pub.dest) {
        par {
            await :mouse.button.dn
            loop {
                var ponto = pico.get.mouse('%')
                var delta = [x=ponto.x -pub.rect.x, y=ponto.y -pub.rect.y]
                set vel = Vetor.multiply(Vetor.normalize(delta), 0.2)

                watching :mouse.button.dn {
                    var d = [x=ponto.x -pub.rect.x, y=ponto.y -pub.rect.y]

                    watching until (Vetor.magnitude(d) <= 0.01)  {

                        loop us on :clock {
                            var dt = us/1s
                            ;; o passo que alcança o ponto para nele (não passa)
                            if Vetor.magnitude(d) <= (0.2 * dt) {
                                set pub.rect.x = ponto.x
                                set pub.rect.y = ponto.y
                            } else {
                                set pub.rect.x = pub.rect.x + (vel.x * dt)
                                set pub.rect.y = pub.rect.y + (vel.y * dt)
                            }
                            set pub.hitbox.x = pub.rect.x
                            set pub.hitbox.y = pub.rect.y
                            set d = [x=ponto.x -pub.rect.x, y=ponto.y -pub.rect.y]
                        }
                    }
                    await(false)
                }
            }
        } with {
            loop on :draw {
                var path = get_img(vel)
                pico.output.draw.image(path, pub.rect)
            }
        }
    }
    pub.dest
}

Pinguim
