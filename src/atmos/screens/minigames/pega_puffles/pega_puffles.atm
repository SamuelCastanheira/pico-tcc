val Image = require "util/components/image"
val Puffle = require "screens/minigames/pega_puffles/puffle"

val path_puffles = [
    "../../assets/imgs/puffle_roundup/puffle_amarelo.png",
    "../../assets/imgs/puffle_roundup/puffle_azul.png",
    "../../assets/imgs/puffle_roundup/puffle_branco.png",
    "../../assets/imgs/puffle_roundup/puffle_vermelho.png",
    "../../assets/imgs/puffle_roundup/puffle_verde.png",
    "../../assets/imgs/puffle_roundup/puffle_laranja.png",
    "../../assets/imgs/puffle_roundup/puffle_rosa.png",
    "../../assets/imgs/puffle_roundup/puffle_roxo.png",
    "../../assets/imgs/puffle_roundup/puffle_preto.png",
    "../../assets/imgs/puffle_roundup/puffle_marrom.png"
]

task PegaPuffles () {
    val dur = 100s
    val dist_max = 0.2
    var num_capturados = 0
    var num_fugiram = 0
    var decorrido = 0

    spawn Image(r, img) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../assets/imgs/puffle_roundup/background.png"
    }

    pin puffles = tasks(#path_puffles)

    val cercado = ['%', x=0.5, y=0.65, w=0.15, h=0.25]

    ;; paredes do cercado, em ordem fixa: esquerda, direita, baixo
    val paredes = [
        ['%', x=0.43, y=0.65, w=0.02, h=0.3, anchor='C'],
        ['%', x=0.58, y=0.65, w=0.02, h=0.3, anchor='C'],
        ['%', x=0.5, y=0.8, w=0.15, h=0.02, anchor='C']
    ]

    loop _,cor in path_puffles {
        val x = math.random(5, 90) / 100
        val y = math.random(10, 50) / 100
        spawn @(puffles) Puffle(['%', x= x,y= y,w=0.05, h=0.05],
            paredes, cor, dist_max, puffles)
    }

    ;; as árvores cobrem os puffles, como no Lua
    spawn Image(r, img) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../assets/imgs/puffle_roundup/arvores.png"
    }

    spawn {
        loop on :puffle.fugiu {
            set num_fugiram = num_fugiram + 1
        }
    }

    spawn {
        loop on :draw {
            pico.set.pencil[color = "yellow"]

            val s_capturados = string.format("%s: %d", "Capturados", num_capturados)
            pico.output.draw.text.dyn(:puf.caps, s_capturados,
            ['%', x=0.02, y=0.02, w=0.008*#s_capturados, h=0.05, anchor='NW'])

            val s_fugiram = string.format("%s: %d", "Fugiram", num_fugiram)
            pico.output.draw.text.dyn(:puf.fugs, s_fugiram,
            ['%', x=0.02, y=0.06, w=0.008*#s_fugiram, h=0.05, anchor='NW'])

            ;; segundos restantes, arredondados para baixo (Timer:getRestante do Lua)
            val s_timer = string.format("%s: %d", "Timer",
                math.floor(math.max(0, dur - decorrido) / 1s))
            pico.output.draw.text.dyn(:puf.timer, s_timer,
            ['%', x=0.9, y=0.02, w=0.008*#s_timer, h=0.1, anchor='NW'])
        }
    }

    ;; cada quadro em fases, como o update do Lua: todos calculam a direção,
    ;; depois todos andam, e então se contam os capturados (o centro do
    ;; puffle dentro do cercado). Termina quando todos os que restam estão
    ;; no cercado (ou nenhum resta) ou quando o tempo acaba.
    loop us on :clock {
        set decorrido = decorrido + us
        emit :puffle.direcao
        emit :puffle.anda [dt = us]

        set num_capturados = 0
        loop _, p in puffles {
            if (!p.pub.fugiu) && pico.vs.pos.rect(p.pub.rect, cercado) {
                set num_capturados = num_capturados + 1
            }
        }
        val restantes = #path_puffles - num_fugiram
        until ((num_capturados == restantes) || (decorrido >= dur))
    }

    num_capturados * 10
}

PegaPuffles
