val Image = require "util/components/image"
val Pilha = require "screens/minigames/bean_counters/pilha"

;; plataforma de entrega: enche a primeira pilha, depois a segunda, e avisa
;; o jogo com :plataforma.cheia
task Plataforma(rect, img, jogo) {
    spawn Image(rect, img)

    set pub = [
        id = :Plataforma,
        rect = rect,
        hitbox = rect
    ]

    pin pilha1 = spawn Pilha(0.1, 0.85, 10, task)
    pin pilha2 = spawn Pilha(0.15, 0.85, 10, task)

    watching :pilha.cheia {
        loop on :pinguim.entrega {
            emit @(pilha1) :plataforma.entrega
        }
    }

    watching :pilha.cheia {
        loop on :pinguim.entrega {
            emit @(pilha2) :plataforma.entrega
        }
    }

    emit @(jogo) :plataforma.cheia
    await(false)
}

Plataforma
