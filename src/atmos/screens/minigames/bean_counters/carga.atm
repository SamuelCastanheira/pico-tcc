val tipos = [
    :Anvil,
    :Flower_pot,
    :Coffe_bag,
    :Fish_bean_counters
]

;; lançamento oblíquo em frações da tela: g em frações por s²; o tempo da
;; carga corre a meia velocidade (ESCALA_TEMPO) para a queda ficar visível
val G = 9.8
val ESCALA_TEMPO = 0.5
val CHAO = 0.9

;; carga lançada do caminhão até um ponto sorteado da neve (os layers das
;; imagens são criados uma vez, pelo BeanCounters)
task Carga() {
    set pub = [
        id = tipos@(math.random(1,#tipos))
    ]
    val img = string.format("../../assets/imgs/bean_counters/%s.webp", pub.id)

    val p0 = [x = 0.85, y = 0.5]
    val destino = [x = (math.random() * (0.75 - 0.25)) + 0.25, y = CHAO]

    ;; ângulo sorteado e velocidade inicial que leva de p0 ao destino
    val min = math.pi/4      ;; 45°
    val max = math.pi/3      ;; 60°
    val dx = destino.x - p0.x
    val dy = p0.y - destino.y
    val angulo = if dx >= 0 => ((math.random() * (max - min)) + min) =>
        ((math.random() * (math.pi - max - (math.pi - min))) + (math.pi - max))
    val cos = math.cos(angulo)
    val v0 = math.sqrt((G * dx * dx) / (2 * (cos * cos) * ((dx * math.tan(angulo)) - dy)))
    val vel = [x = v0 * cos, y = (-v0) * math.sin(angulo)]
    val giro0 = math.deg(math.atan2(vel.y, vel.x))

    set pub.rect = ['%', x = p0.x, y = p0.y, w = 0.08, h = 0.08]
    set pub.hitbox = pub.rect

    ;; posição exata no instante t
    var t = 0
    spawn {
        loop us on :clock {
            set t = t + ((us * ESCALA_TEMPO) / 1s)
            set pub.rect.x = p0.x + (vel.x * t)
            set pub.rect.y = (p0.y + (vel.y * t)) + ((G * math.pow(t, 2)) / 2)
        }
    }

    ;; o saco de café gira acompanhando a direção do movimento
    spawn {
        loop on :draw {
            if pub.id == :Coffe_bag {
                val giro = math.deg(math.atan2(vel.y + (G * t), vel.x)) - giro0
                pico.set.layer(img)
                pico.set.effect[rotate = [angle = math.floor(giro + 0.5), anchor = 'C']]
                pico.set.layer(:world)
            }
            pico.output.draw.layer(img, pub.rect)
        }
    }

    await until (pub.rect.y > CHAO)
}

Carga
