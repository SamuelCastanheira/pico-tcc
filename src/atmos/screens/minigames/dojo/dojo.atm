val Image = require "util/components/image"
val Carta = require "screens/minigames/dojo/carta"

val num_cartas = 3

val cartas = [
    [elem = :FOGO, power = 4, img = "../../assets/imgs/dojo/fogo_4.png"],
    [elem = :FOGO, power = 7, img = "../../assets/imgs/dojo/fogo_7.png"],
    [elem = :GELO, power = 5, img = "../../assets/imgs/dojo/gelo_5.png"],
    [elem = :GELO, power = 6, img = "../../assets/imgs/dojo/gelo_6.png"],
]

;; cada elemento vence o seguinte nesta tabela
val VENCE = [GELO = "AGUA", AGUA = "FOGO", FOGO = "GELO"]

task Dojo(){
    pico.set.window [ title="Dojo" ]
    var player_wins = 0
    var enemy_wins = 0

    spawn Image(r, img) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1]
        img = "../../assets/imgs/dojo/background.png"
    }

    pin playerDeck = tasks(num_cartas)
    sorteiaCartas(:player, playerDeck, task)
    pin enemyDeck = tasks(num_cartas)
    sorteiaCartas(:enemy, enemyDeck, task)

    loop in num_cartas {
        ;; só cartas do jogador: um prédio clicado no centro, por baixo do
        ;; Dojo, também emite :clicked para a árvore do centro
        val player_card = await <:clicked until (it.me.pub.id == :player)>

        ;; o inimigo joga uma carta da mão, ao acaso
        val idx = math.random(1, #enemyDeck)
        val enemy_card = loop i,card in enemyDeck {
            until(i == idx, card)
        }

        ordenaCartas(:player, playerDeck, player_card.me)
        ordenaCartas(:enemy, enemyDeck, enemy_card)

        val resul = comparaCartas(player_card.me, enemy_card)
        ifs {
            (resul > 0) => set player_wins = player_wins + 1
            (resul < 0) => set enemy_wins = enemy_wins + 1
        }

        emit @(player_card.me) :present [resul = resul]
        emit @(enemy_card) :present [resul = -resul]

        await 2s
    }

    ifs {
        player_wins > enemy_wins =>  100
        player_wins == enemy_wins =>  50
        else => 0
    }
}

;; retângulo da i-ésima carta (a partir de 0) na mão de cada lado
func pos (id, i) {
    val x = if (id == :player) => 0.9 => 0.1
    val dir = if (id == :player) => -1 => 1
    ['%', x = x + (dir * i * 0.12), y = 0.88, w = 0.1, h = 0.2]
}

;; reposiciona as cartas que ficam na mão, sem a jogada
func ordenaCartas(id, deck, carta) {
    var i = 0
    loop _,c in deck {
        if carta != c {
            set c.pub.rect = pos(id, i)
            set i = i + 1
        }
    }
}

;; num_cartas cartas diferentes, sorteadas ao acaso
func sorteiaCartas(id, deck, dojo) {
    val usadas = []
    loop {
        until (#deck == num_cartas)
        val idx = math.random(1, #cartas)
        if !usadas@idx {
            set usadas@idx = true
            val c = cartas@idx
            spawn @(deck) Carta(id, pos(id, #deck), c.img, c.elem, c.power, dojo)
        }
    }
}

;; 1 se p vence e, -1 se perde, 0 se empata
func comparaCartas(p, e) {
    ifs {
        p.pub.elem == e.pub.elem => ifs {
            p.pub.power > e.pub.power => 1
            p.pub.power < e.pub.power => -1
            else => 0
        }
        VENCE@(p.pub.elem) == e.pub.elem => 1
        else => -1
    }
}

Dojo
