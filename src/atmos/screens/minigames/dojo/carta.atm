val Image = require "util/components/image"
val XClickable = require "util/components/xclickable"

;; carta: na mão até ser jogada (:present); depois, 2 s no campo de batalha
;; com o resultado. As cartas do jogador avisam o Dojo quando clicadas.
task Carta(id, rect, path, elem, power, dojo)
{
    set pub = [
        id = id,
        rect = rect,
        elem = elem,
        power = power
    ]

    val battle_rect = if (id == :player) => ['%', x=0.8, y=0.3, w=0.2, h=0] =>
        ['%', x=0.2, y=0.3, w=0.2, h=0]

    val verso = "../../assets/imgs/dojo/carta_azul.png"

    if (id == :player) => spawn XClickable(dojo, task)

    val r = watching :present {
        loop on :draw {
            pico.output.draw.image((if (id == :player) => path => verso), pub.rect)
        }
    }

    spawn Image(battle_rect, path)

    watching 2s {
        await Image(battle_rect, (if r.resul > -1 => "../../assets/imgs/dojo/ok.png" => "../../assets/imgs/dojo/x.png"))
    }
}

Carta
