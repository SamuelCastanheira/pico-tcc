;; imagem que troca para "on_" enquanto o mouse está em cima (sem "on_", fixa)
task Image_Hover (rect, off, on_) {
    loop on :draw {
        val m = pico.get.mouse('%')
        var img = off
        if on_ && pico.vs.pos.rect(['%', x=m.x, y=m.y], rect) {
            set img = on_
        }
        pico.output.draw.image(img, rect)
    }
}

Image_Hover
