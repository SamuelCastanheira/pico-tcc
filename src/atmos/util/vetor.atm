;; operações de vetor 2D usadas pelos pinguins e puffles (devolvem vetores novos)
var Vetor = []

func Vetor.magnitude(v){
    math.sqrt((v.x * v.x) + (v.y * v.y))
}

func Vetor.normalize(v){
    val mag = Vetor.magnitude(v)
    if mag > 0 => [x = v.x / mag, y = v.y / mag] => [x = 0, y = 0]
}

func Vetor.subtract(v1, v2){
    [x = v1.x - v2.x, y = v1.y - v2.y]
}

func Vetor.multiply(v, scalar){
    [x = v.x * scalar, y = v.y * scalar]
}

func Vetor.dot(v1, v2){
    (v1.x * v2.x) + (v1.y * v2.y)
}

func Vetor.angle(v){
    math.atan2(v.y, v.x)
}

Vetor
